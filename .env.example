PORT=3000
# Opcional. Sem TURN, algumas redes não conseguem conectar.
STUN_URL=stun:stun.l.google.com:19302
# URLs separadas por vírgula. Configure seu servidor/serviço TURN.
# TURN_URLS=turn:seu-servidor:3478,turns:seu-servidor:5349
# Preferido: segredo de autenticação REST do coturn; gera credenciais temporárias.
# TURN_SECRET=
# Alternativa para serviços com credenciais próprias:
# TURN_USERNAME=
# TURN_PASSWORD=

# Em hospedagem com domínio próprio. Render usa RENDER_EXTERNAL_URL automaticamente.
# PUBLIC_ORIGIN=https://seu-dominio
